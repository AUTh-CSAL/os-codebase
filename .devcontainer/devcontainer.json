{
  // GitHub Codespaces for the OS labs: Ubuntu 24.04, like the other paths,
  // with the same tools installed by the same script.
  "name": "OS labs (xv6 on RISC-V)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "postCreateCommand": "bash env/setup.sh",
  // SSH server, so that `gh codespace ssh` works from a local terminal.
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "hostRequirements": { "cpus": 2 },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools"],
      // Let Ctrl+P (xv6's process list) and Ctrl+K (nano's cut) reach the
      // terminal instead of VS Code.
      "settings": {
        "terminal.integrated.allowChords": false,
        "terminal.integrated.commandsToSkipShell": ["-workbench.action.quickOpen"]
      }
    }
  }
}
